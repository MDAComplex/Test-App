# PostgreSQL connection string (Neon, Vercel Postgres, or any Postgres).
# On Vercel: added automatically when you create Neon storage via the
# Vercel dashboard (Storage tab → Create Database → Neon Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# For Prisma CLI (migrations/db push/seed) - use the non-pooling URL.
# Vercel's Neon integration sets this automatically.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Seed-only: plaintext password for the admin account created by prisma/seed.ts.
ADMIN_SEED_PASSWORD="ChangeMe123!"
